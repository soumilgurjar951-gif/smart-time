# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-use-a-long-random-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS ─────────────────────────────────────────────────────────────────────
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ──────────────────────────────────────────────────────────────────
# For local development without MySQL, leave DB_ENGINE as sqlite3.
# Switch to mysql and fill in DB_* values for production.
DB_ENGINE=django.db.backends.sqlite3
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=odrms
# DB_USER=odrms
# DB_PASSWORD=your-mysql-password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ── JWT token lifetimes ───────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# ── Celery + Redis ────────────────────────────────────────────────────────────
# Install Redis (https://redis.io) then uncomment:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_RETAIN_DAYS=7

# ── Google Gmail API (OAuth 2.0) — backend only ────────────────────────────────
# Setup: Google Cloud Console → APIs & Services → Enable "Gmail API" → OAuth 2.0 Client ID (Web) → add redirect URI below.
# Placeholders only; real values must stay in backend/.env (gitignored).
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SENDER_EMAIL=your-gmail-address@gmail.com
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.send
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
